# Kopjojeni si `.env.prod` në server dhe plotësoni vlerat.
# KURRË mos e vendosni .env.prod në git!

# Domain-i që tregon te IP-ja e serverit (A-Record), p.sh. app.tiff-software.ch
DOMAIN=app.beispiel.ch

# Öffentliche Adresse der App (für Links in E-Mails, z.B. Passwort-Reset) — Pflicht
APP_URL=https://app.beispiel.ch

# TIFF-Administratoren (E-Mails, Komma-getrennt): dürfen neue Kunden-Betriebe anlegen
TIFF_ADMIN_EMAILS=

# Support-Kontakt, der in der App angezeigt wird (leer = Platzhalter!)
TIFF_SUPPORT_EMAIL=
TIFF_SUPPORT_TELEFON=

# Öffentliche Registrierung: leer lassen (geschlossen). Nur für Demo-Systeme: offen
REGISTRIERUNG=

# Fjalëkalim i fortë për PostgreSQL (gjeneroni: openssl rand -base64 24)
DB_PASSWORT=NDRYSHO-KETE-PATJETER

# E-Mail-Versand (SMTP i Infomaniak-ut ose Postmark) — opsionale në fillim
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
