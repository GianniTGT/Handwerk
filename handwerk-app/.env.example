# Kopjojeni këtë skedar si `.env` dhe përshtatni sipas nevojës
DATABASE_URL="postgresql://handwerk:handwerk_dev@localhost:5432/handwerk"
# Në prodhim prapa TLS (Caddy): vendoseni në 1 që cookie e sesionit të jetë "secure"
COOKIE_SECURE=0

# E-Mail-Versand (opsionale — pa to email-et simulohen)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Registrierung: Standard geschlossen. Nur bewusst öffnen (z.B. Demo): REGISTRIERUNG=offen
REGISTRIERUNG=
# TIFF-Administratoren (E-Mail, Komma-getrennt): dürfen unter /admin/betriebe neue Kunden-Betriebe anlegen
TIFF_ADMIN_EMAILS=

# Basis-URL der App fuer Links in E-Mails (Passwort-Reset). In Produktion Pflicht, z.B. https://app.tiff-software.ch
APP_URL=

# Optional: API-Schluessel von Search.ch (liefert zusaetzlich E-Mail/Website/Branche beim Kontakt-Import)
SEARCHCH_API_KEY=
