// Modeli i të dhënave — Handwerk (Sanitär/Heizung)
// Multi-tenant që nga dita 1: çdo tabelë operative lidhet me një Betrieb.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Firma që përdor softuerin (tenant-i), p.sh. Aino Haustechnik GmbH
model Betrieb {
  id        String   @id @default(cuid())
  name      String
  strasse   String   @default("")
  plz       String   @default("")
  ort       String   @default("")
  iban      String   @default("") // IBAN/QR-IBAN për QR-Rechnung
  mwstNr    String   @default("")
  email     String   @default("")
  telefon   String   @default("")
  bank      String   @default("") // p.sh. "UBS Switzerland AG"
  bic       String   @default("")
  // Dokumenten-Designer (si te bexio): logo + ngjyrat e dokumenteve PDF
  logo        String @default("") // data-URL (PNG/JPEG, max ~500 KB)
  farbeTitel  String @default("#1C1C1E")
  farbeLinien String @default("#9AA5A0")
  farbeText   String @default("#1C1C1E")
  zahlungsfristTage Int @default(30) // afati i pagesës për faturat e reja
  // Mahnwesen (si te bexio): ditë pas afatit / pas mahnimit të mëparshëm
  mahnfrist1Tage Int @default(14) // Zahlungserinnerung pas afatit
  mahnfrist2Tage Int @default(10) // Mahnung 1 pas kujtesës
  mahnfrist3Tage Int @default(7)  // Mahnung 2 pas Mahnung 1
  rechnungKopftext String @default("")
  rechnungFusstext String @default("")
  offerteKopftext  String @default("")
  offerteFusstext  String @default("")
  erstellt  DateTime @default(now())

  mitarbeiter Mitarbeiter[]
  kunden      Kunde[]
  auftraege   Auftrag[]
  artikel     Artikel[]
  rechnungen  Rechnung[]
  lieferanten Lieferant[]
  konditionen Kondition[]
  offerten    Offerte[]
  wartungsvertraege Wartungsvertrag[]
  ausgaben    Ausgabe[]
  zahlungen   Zahlung[]
  belege      Beleg[]
  nummernkreise Nummernkreis[]
  mailvorlagen MailVorlage[]
  lieferscheine Lieferschein[]
  gutschriften Gutschrift[]
  projekte    Projekt[]
  zeiten      Zeiteintrag[]
  bestellungen Bestellung[]
  zugaenge    BetriebZugang[]
  aufgaben    Aufgabe[]
  rechnungslaeufe Rechnungslauf[]
}

model Mitarbeiter {
  id           String  @id @default(cuid())
  betriebId    String
  betrieb      Betrieb @relation(fields: [betriebId], references: [id])
  name         String
  rolle        String  @default("MONTEUR") // MONTEUR | BUERO | CHEF
  email        String? @unique // e nevojshme vetëm për llogaritë me login
  passwortHash String  @default("")
  stundensatz  Float   @default(0) // CHF/h për zeitërfassung → faturim
  aktiv        Boolean @default(true) // false = nuk mund të hyjë më (historia mbetet)
  dashboard    String  @default("") // JSON {order:[...], hidden:[...]} — rendi/dukshmëria e widget-eve
  passwortAendern Boolean @default(false) // true = duhet të ndryshojë fjalëkalimin para se të vazhdojë (llogari e re / e rivendosur nga admini)
  rechte       String  @default("") // lista e zonave me presje; bosh = standard sipas rolles
  foto         String  @default("") // Profilbild als data-URL (JPEG, clientseitig auf 256 px verkleinert)
  zeiten       Zeiteintrag[]
  aufgaben     Aufgabe[]
  resets       PasswortReset[]
  rapporte     Rapport[]
  sitzungen    Sitzung[]
  zugaenge     BetriebZugang[] // firma-klientë shtesë që mund t'i ndërrojë (TIFF-Support)
}

// Qasje shtesë: p.sh. mbështetja e TIFF ndërron mes firmave-klientë (si te bexio)
model BetriebZugang {
  mitarbeiterId String
  mitarbeiter   Mitarbeiter @relation(fields: [mitarbeiterId], references: [id], onDelete: Cascade)
  betriebId     String
  betrieb       Betrieb     @relation(fields: [betriebId], references: [id], onDelete: Cascade)

  @@id([mitarbeiterId, betriebId])
}

// Sesionet e login-it (cookie httpOnly me token)
model Sitzung {
  id            String      @id @default(cuid())
  token         String      @unique
  mitarbeiterId String
  mitarbeiter   Mitarbeiter @relation(fields: [mitarbeiterId], references: [id], onDelete: Cascade)
  erstellt      DateTime    @default(now())
  gueltigBis    DateTime
  aktiverBetriebId String? // firma e zgjedhur me dropdown (null = Betrieb-i vetë)
}

model Kunde {
  id        String  @id @default(cuid())
  betriebId String
  betrieb   Betrieb @relation(fields: [betriebId], references: [id])
  name      String
  strasse   String  @default("")
  plz       String  @default("")
  ort       String  @default("")
  telefon   String  @default("")
  email     String  @default("")
  typ       String  @default("FIRMA") // FIRMA | PRIVAT
  kategorie String  @default("") // p.sh. Hausverwaltung, Privatkunde, Gewerbe
  mobile    String  @default("")
  website   String  @default("")
  bemerkung String  @default("")
  archiviert Boolean @default(false)
  // Fusha shtesë si te bexio
  kontaktNr Int?  // numri automatik i kontaktit
  anrede    String @default("")
  vorname   String @default("") // vetëm Privat
  nachname  String @default("") // vetëm Privat
  zusatz    String @default("") // Firmennamen-Zusatz
  adresszusatz String @default("")
  land      String @default("Schweiz")
  email2    String @default("")
  telefon2  String @default("")
  ansprechpartnerId String? // Mitarbeiter i brendshëm përgjegjës
  korrespondenzweg String @default("MAIL") // MAIL | POST
  sprache   String @default("DE")
  branche   String @default("")
  rabatt    Float  @default(0)
  anzahlMitarbeiter Int?
  handelsregisterNr String @default("")
  mwstNr    String @default("")
  uid       String @default("")
  kontaktpersonen Kontaktperson[]
  projekte  Projekt[]
  zeiten    Zeiteintrag[]
  objekte   Objekt[]
  auftraege Auftrag[]
  offerten  Offerte[]
  wartungsvertraege Wartungsvertrag[]
}

// Person kontakti te një klient (p.sh. Hausverwaltung → administratori)
model Kontaktperson {
  id       String @id @default(cuid())
  kundeId  String
  kunde    Kunde  @relation(fields: [kundeId], references: [id], onDelete: Cascade)
  name     String
  funktion String @default("")
  email    String @default("")
  telefon  String @default("")
  mobile   String @default("")
}

// Objekti/pajisja te klienti (kaldaja, bojleri, banjoja...) — njësia qendrore në SHK
model Objekt {
  id          String  @id @default(cuid())
  kundeId     String
  kunde       Kunde   @relation(fields: [kundeId], references: [id])
  bezeichnung String  // p.sh. "Heizung Keller — Viessmann Vitodens 200"
  strasse     String  @default("")
  plz         String  @default("")
  ort         String  @default("")
  bemerkung   String  @default("")
  auftraege   Auftrag[]
  offerten    Offerte[]
  wartungsvertraege Wartungsvertrag[]
}

model Auftrag {
  id           String   @id @default(cuid())
  betriebId    String
  betrieb      Betrieb  @relation(fields: [betriebId], references: [id])
  kundeId      String
  kunde        Kunde    @relation(fields: [kundeId], references: [id])
  objektId     String?
  objekt       Objekt?  @relation(fields: [objektId], references: [id])
  nummer       Int
  titel        String
  beschreibung String   @default("")
  status       String   @default("OFFEN") // OFFEN | IN_ARBEIT | ERLEDIGT | VERRECHNET
  datum        DateTime @default(now())
  projektId    String?
  projekt      Projekt? @relation(fields: [projektId], references: [id])
  zeiten       Zeiteintrag[]
  lieferscheine Lieferschein[]
  rapporte     Rapport[]
  rechnungen   Rechnung[]
  offerte      Offerte?
}

// Oferta (Angebot) me grupe pozicionesh hierarkike: 1 / 1.1 / 1.2 …
// (struktura e vërejtur te oferta reale e Wasserdichter me Bexio)
model Offerte {
  id         String   @id @default(cuid())
  betriebId  String
  betrieb    Betrieb  @relation(fields: [betriebId], references: [id])
  kundeId    String
  kunde      Kunde    @relation(fields: [kundeId], references: [id])
  objektId   String?
  objekt     Objekt?  @relation(fields: [objektId], references: [id])
  nummer     Int
  nummerText String @default("")
  titel      String
  status     String   @default("ENTWURF") // ENTWURF | GESENDET | ANGENOMMEN | ABGELEHNT
  datum      DateTime @default(now())
  gueltigBis DateTime
  auftragId  String?  @unique // vendoset pas konvertimit Offerte → Auftrag
  auftrag    Auftrag? @relation(fields: [auftragId], references: [id])
  gruppen    OfferteGruppe[]
}

model OfferteGruppe {
  id          String  @id @default(cuid())
  offerteId   String
  offerte     Offerte @relation(fields: [offerteId], references: [id], onDelete: Cascade)
  reihenfolge Int     @default(0)
  titel       String
  positionen  OffertePosition[]
}

model OffertePosition {
  id          String        @id @default(cuid())
  gruppeId    String
  gruppe      OfferteGruppe @relation(fields: [gruppeId], references: [id], onDelete: Cascade)
  reihenfolge Int           @default(0)
  bezeichnung String // shumërreshtore: rreshtat shtesë bëhen bullets në PDF
  menge       Float         @default(1)
  einheit     String        @default("Stk.")
  ansatz      Float         @default(0)
}

// Regierapport / Serviceauftrag-dokumentimi nga tereni
model Rapport {
  id            String   @id @default(cuid())
  auftragId     String
  auftrag       Auftrag  @relation(fields: [auftragId], references: [id])
  mitarbeiterId String?
  mitarbeiter   Mitarbeiter? @relation(fields: [mitarbeiterId], references: [id])
  datum         DateTime @default(now())
  bemerkung     String   @default("")
  unterschrift  String   @default("") // nënshkrimi i klientit si data-URL (PNG)
  positionen    RapportPosition[]
  fotos         RapportFoto[]
}

// Foto-dokumentimi nga tereni (para/pas, defekti, pjesa e montuar…)
// Ruhet si data-URL i zvogëluar në klient (max ~1600px JPEG) — për pilotin
// në DB; më vonë object storage (shih docs/cloud-strategjia.md)
model RapportFoto {
  id        String   @id @default(cuid())
  rapportId String
  rapport   Rapport  @relation(fields: [rapportId], references: [id], onDelete: Cascade)
  daten     String // data-URL (image/jpeg|png|webp)
  bemerkung String   @default("")
  erstellt  DateTime @default(now())
}

model RapportPosition {
  id          String  @id @default(cuid())
  rapportId   String
  rapport     Rapport @relation(fields: [rapportId], references: [id], onDelete: Cascade)
  typ         String  // ARBEIT | MATERIAL
  bezeichnung String
  menge       Float   @default(1)
  einheit     String  @default("Std.") // Std. | Stk. | m | pauschal
  ansatz      Float   @default(0) // çmimi për njësi në CHF
}

// Furnitori (Debrunner Acifer, Meier Tobler, Sanitas Troesch…)
model Lieferant {
  id          String  @id @default(cuid())
  betriebId   String
  betrieb     Betrieb @relation(fields: [betriebId], references: [id])
  name        String
  artikel     Artikel[]
  konditionen Kondition[]
  bestellungen Bestellung[]
}

// Katalogu i artikujve (import CSV/Excel; më vonë IGH/DataExpert)
model Artikel {
  id           String     @id @default(cuid())
  betriebId    String
  betrieb      Betrieb    @relation(fields: [betriebId], references: [id])
  lieferantId  String?
  lieferant    Lieferant? @relation(fields: [lieferantId], references: [id])
  artikelNr    String     @default("")
  bezeichnung  String
  einheit      String     @default("Stk.")
  preis        Float      @default(0) // çmimi neto manual (për artikuj pa furnitor/zbritje)
  bruttoPreis  Float      @default(0) // çmimi bruto i katalogut
  rabattgruppe String     @default("") // grupi i zbritjes te furnitori
  art          String     @default("WARE") // WARE | DIENSTLEISTUNG
  gruppe       String     @default("")
  einkaufspreis Float     @default(0) // EK manual → me zuschlag jep preis (VK)
  zuschlagProzent Float   @default(0)
  mwstSatz     Float      @default(8.1)
}

// Zbritja e firmës te një furnitor për një grup artikujsh:
// neto = bruttoPreis × (1 − rabattProzent/100)
model Kondition {
  id            String    @id @default(cuid())
  betriebId     String
  betrieb       Betrieb   @relation(fields: [betriebId], references: [id])
  lieferantId   String
  lieferant     Lieferant @relation(fields: [lieferantId], references: [id])
  rabattgruppe  String
  rabattProzent Float

  @@unique([betriebId, lieferantId, rabattgruppe])
}

model Rechnung {
  id         String   @id @default(cuid())
  betriebId  String
  betrieb    Betrieb  @relation(fields: [betriebId], references: [id])
  auftragId  String
  auftrag    Auftrag  @relation(fields: [auftragId], references: [id])
  nummer     Int
  nummerText String   @default("") // numri i formatuar sipas Nummernkreis
  art        String   @default("SCHLUSS") // TEIL (Akonto) | SCHLUSS
  bezeichnung String  @default("") // titulli i Teilrechnung-it (p.sh. Akonto 30%)
  abzugNetto Float    @default(0) // Schlussrechnung: neto e Teilrechnung-eve të zbritura
  datum      DateTime @default(now())
  faelligAm  DateTime? // afati i pagesës; null = datum + 30 ditë (faturat e vjetra)
  status     String   @default("ENTWURF") // ENTWURF | VERSENDET | BEZAHLT
  mahnstufe  Int      @default(0) // 0 = pa | 1 Zahlungserinnerung | 2 Mahnung 1 | 3 Mahnung 2
  letzteMahnungAm DateTime?
  gutschriften Gutschrift[]
  totalNetto Float    @default(0)
  mwstSatz   Float    @default(8.1) // norma standarde CH 2026
  totalBrutto Float   @default(0)
}

// Kontrata e mirëmbajtjes (Wartungsvertrag) — ari i biznesit Heizung.
// Lidhet me OBJEKTIN (kaldajën), jo vetëm me klientin: sistemi kujton kur
// i vjen koha servisit dhe krijon Auftrag-un me një klik.
model Wartungsvertrag {
  id              String   @id @default(cuid())
  betriebId       String
  betrieb         Betrieb  @relation(fields: [betriebId], references: [id])
  kundeId         String
  kunde           Kunde    @relation(fields: [kundeId], references: [id])
  objektId        String
  objekt          Objekt   @relation(fields: [objektId], references: [id])
  nummer          Int
  titel           String   @default("Jahreswartung Heizung")
  intervallMonate Int      @default(12) // 12 = vjetore, 6 = gjysmëvjetore
  naechsteWartung DateTime
  preis           Float    @default(0) // çmimi i rënë dakord për servis
  bemerkung       String   @default("")
  status          String   @default("AKTIV") // AKTIV | PAUSIERT | GEKUENDIGT
  pauschalAbrechnung Boolean @default(false) // pauschala verrechnohet automatikisht në Rechnungslauf
  naechsteRechnung DateTime? // data e faturimit të radhës (null = naechsteWartung)
  erstellt        DateTime @default(now())
}

// Shpenzim / faturë furnitori (Ausgaben)
model Ausgabe {
  id           String    @id @default(cuid())
  betriebId    String
  betrieb      Betrieb   @relation(fields: [betriebId], references: [id], onDelete: Cascade)
  lieferant    String    @default("")
  beschreibung String
  kategorie    String    @default("Material")
  datum        DateTime  @default(now())
  faelligAm    DateTime?
  betragBrutto Float     @default(0)
  mwstSatz     Float     @default(8.1)
  status       String    @default("OFFEN") // OFFEN | BEZAHLT
  projektId    String? // material i lidhur me projektin (Nachkalkulation)
  erstellt     DateTime  @default(now())
}

// Lëvizje banke (Banking): pozitive = hyrje (pagesë klienti), negative = dalje
model Zahlung {
  id         String   @id @default(cuid())
  betriebId  String
  betrieb    Betrieb  @relation(fields: [betriebId], references: [id], onDelete: Cascade)
  datum      DateTime @default(now())
  text       String   @default("")
  betrag     Float
  referenz   String   @default("")
  rechnungId String? // e lidhur me faturë klienti (shënohet BEZAHLT)
  erstellt   DateTime @default(now())
}

// Posteingang: dokumente të ngarkuara (fatura furnitori, letra) për t'u përpunuar
model Beleg {
  id        String   @id @default(cuid())
  betriebId String
  betrieb   Betrieb  @relation(fields: [betriebId], references: [id], onDelete: Cascade)
  titel     String
  dateiname String   @default("")
  mimeTyp   String   @default("")
  daten     String   @default("") // data-URL (PDF/JPEG/PNG, max ~3 MB)
  status    String   @default("NEU") // NEU | ERLEDIGT
  erstellt  DateTime @default(now())
}

// Kreditnotë për faturë klienti (Gutschrift) — zvogëlon shumën e hapur
model Gutschrift {
  id          String   @id @default(cuid())
  betriebId   String
  betrieb     Betrieb  @relation(fields: [betriebId], references: [id], onDelete: Cascade)
  rechnungId  String
  rechnung    Rechnung @relation(fields: [rechnungId], references: [id])
  nummer      Int
  nummerText String @default("")
  datum       DateTime @default(now())
  grund       String   @default("")
  totalNetto  Float
  mwstSatz    Float    @default(8.1)
  totalBrutto Float
}

// Projekti = kantier / objekt-pune (si te bexio, me substatus të lirë)
model Projekt {
  id           String   @id @default(cuid())
  betriebId    String
  betrieb      Betrieb  @relation(fields: [betriebId], references: [id], onDelete: Cascade)
  kundeId      String?
  kunde        Kunde?   @relation(fields: [kundeId], references: [id])
  nummer       Int
  nummerText String @default("")
  name         String
  typ          String   @default("KUNDE") // KUNDE | INTERN
  status       String   @default("OFFEN") // OFFEN | AKTIV | ARCHIVIERT
  substatus    String   @default("")
  start        DateTime?
  ende         DateTime?
  beschreibung String   @default("")
  erstellt     DateTime @default(now())
  auftraege    Auftrag[]
  zeiten       Zeiteintrag[]
}

// Orë pune (Zeiterfassung) — e abrechenbar → bëhet pozicion rapporti/faturë
model Zeiteintrag {
  id            String       @id @default(cuid())
  betriebId     String
  betrieb       Betrieb      @relation(fields: [betriebId], references: [id], onDelete: Cascade)
  mitarbeiterId String
  mitarbeiter   Mitarbeiter  @relation(fields: [mitarbeiterId], references: [id])
  projektId     String?
  projekt       Projekt?     @relation(fields: [projektId], references: [id])
  auftragId     String?
  auftrag       Auftrag?     @relation(fields: [auftragId], references: [id])
  kundeId       String?
  kunde         Kunde?       @relation(fields: [kundeId], references: [id])
  taetigkeit    String       @default("Umsetzung")
  datum         DateTime     @default(now())
  minuten       Int
  bemerkung     String       @default("")
  abrechenbar   Boolean      @default(true)
  stundensatz   Float        @default(0)
  status        String       @default("OFFEN") // OFFEN | ERLEDIGT | FAKTURIERT
  erstellt      DateTime     @default(now())
}

// Porosi te furnitori (Bestellung)
model Bestellung {
  id          String    @id @default(cuid())
  betriebId   String
  betrieb     Betrieb   @relation(fields: [betriebId], references: [id], onDelete: Cascade)
  lieferantId String
  lieferant   Lieferant @relation(fields: [lieferantId], references: [id])
  nummer      Int
  nummerText String @default("")
  datum       DateTime  @default(now())
  status      String    @default("ENTWURF") // ENTWURF | BESTELLT | GELIEFERT
  bemerkung   String    @default("")
  positionen  BestellPosition[]
}

model BestellPosition {
  id           String     @id @default(cuid())
  bestellungId String
  bestellung   Bestellung @relation(fields: [bestellungId], references: [id], onDelete: Cascade)
  artikelNr    String     @default("")
  bezeichnung  String
  menge        Float      @default(1)
  einheit      String     @default("Stk.")
  preis        Float      @default(0)
}

// Numërimi i dokumenteve (si te bexio): format, gjatësi minimale, fillim, rifillim vjetor
model Nummernkreis {
  id          String  @id @default(cuid())
  betriebId   String
  betrieb     Betrieb @relation(fields: [betriebId], references: [id], onDelete: Cascade)
  typ         String  // OFFERTE | RECHNUNG | GUTSCHRIFT | BESTELLUNG | PROJEKT
  format      String  // p.sh. "RE-{JJJJ}-{NR}"  ({JJJJ}=viti 4-shifror, {JJ}=2-shifror, {NR}=numri)
  laenge      Int     @default(1) // gjatësia minimale e {NR} (plotësuar me zero)
  jaehrlichNeu Boolean @default(false)
  naechste    Int     @default(1)
  startNummer Int     @default(1) // fillimi pas rifillimit vjetor
  jahr        Int     @default(0) // viti i numrit të fundit të dhënë

  @@unique([betriebId, typ])
}

// Shabllone email-i për dokumentet (Offerte, Rechnung, 3 shkallët e Mahnung)
model MailVorlage {
  id        String  @id @default(cuid())
  betriebId String
  betrieb   Betrieb @relation(fields: [betriebId], references: [id], onDelete: Cascade)
  typ       String  // OFFERTE | RECHNUNG | MAHNUNG1 | MAHNUNG2 | MAHNUNG3
  betreff   String
  text      String

  @@unique([betriebId, typ])
}

// Lieferschein (fletë-dorëzimi) për materiale të dorëzuara te klienti — pa çmime
model Lieferschein {
  id         String   @id @default(cuid())
  betriebId  String
  betrieb    Betrieb  @relation(fields: [betriebId], references: [id], onDelete: Cascade)
  auftragId  String
  auftrag    Auftrag  @relation(fields: [auftragId], references: [id])
  nummer     Int
  nummerText String   @default("")
  datum      DateTime @default(now())
  status     String   @default("ENTWURF") // ENTWURF | GELIEFERT
  bemerkung  String   @default("")
  positionen LieferscheinPosition[]
}

model LieferscheinPosition {
  id             String       @id @default(cuid())
  lieferscheinId String
  lieferschein   Lieferschein @relation(fields: [lieferscheinId], references: [id], onDelete: Cascade)
  bezeichnung    String
  menge          Float        @default(1)
  einheit        String       @default("Stk.")
}

// Detyrë (To-do) për ekipin: e caktuar te një Mitarbeiter, opsionalisht e lidhur me klient/projekt/auftrag
model Aufgabe {
  id            String       @id @default(cuid())
  betriebId     String
  betrieb       Betrieb      @relation(fields: [betriebId], references: [id], onDelete: Cascade)
  titel         String
  beschreibung  String       @default("")
  kategorie     String       @default("")
  faelligAm     DateTime?
  status        String       @default("OFFEN") // OFFEN | ERLEDIGT
  zugewiesenAnId String?
  zugewiesenAn  Mitarbeiter? @relation(fields: [zugewiesenAnId], references: [id])
  kundeId       String?
  projektId     String?
  auftragId     String?
  erstellt      DateTime     @default(now())
  erledigtAm    DateTime?
}

// Ditar i ekzekutimeve të Rechnungslauf (faturim periodik i kontratave të mirëmbajtjes)
model Rechnungslauf {
  id          String   @id @default(cuid())
  betriebId   String
  betrieb     Betrieb  @relation(fields: [betriebId], references: [id], onDelete: Cascade)
  datum       DateTime @default(now())
  anzahl      Int
  summeBrutto Float
  details     String   @default("") // lista e fatura të krijuara
}

// Mbrojtje nga brute-force: gabime të hyrjes sipas email-it dhe IP-së; pas pragut → bllokim i përkohshëm
model LoginVersuch {
  id          String    @id @default(cuid())
  schluessel  String    @unique // "mail:<email>" ose "ip:<adresa>"
  fehler      Int       @default(0)
  fensterStart DateTime @default(now())
  gesperrtBis DateTime?
}

// Token për rivendosjen e fjalëkalimit me email (ruhet vetëm hash-i SHA-256; vlefshëm 60 min, përdoret një herë)
model PasswortReset {
  id            String      @id @default(cuid())
  mitarbeiterId String
  mitarbeiter   Mitarbeiter @relation(fields: [mitarbeiterId], references: [id], onDelete: Cascade)
  tokenHash     String      @unique
  gueltigBis    DateTime
  erstellt      DateTime    @default(now())
}
