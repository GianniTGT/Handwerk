// Modeli i të dhënave — Handwerk (Sanitär/Heizung)
// Multi-tenant që nga dita 1: çdo tabelë operative lidhet me një Betrieb.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Firma që përdor softuerin (tenant-i), p.sh. Aino Haustechnik GmbH
model Betrieb {
  id        String   @id @default(cuid())
  name      String
  strasse   String   @default("")
  plz       String   @default("")
  ort       String   @default("")
  iban      String   @default("") // IBAN/QR-IBAN për QR-Rechnung
  mwstNr    String   @default("")
  email     String   @default("")
  telefon   String   @default("")
  bank      String   @default("") // p.sh. "UBS Switzerland AG"
  bic       String   @default("")
  erstellt  DateTime @default(now())

  mitarbeiter Mitarbeiter[]
  kunden      Kunde[]
  auftraege   Auftrag[]
  artikel     Artikel[]
  rechnungen  Rechnung[]
  lieferanten Lieferant[]
  konditionen Kondition[]
  offerten    Offerte[]
}

model Mitarbeiter {
  id           String  @id @default(cuid())
  betriebId    String
  betrieb      Betrieb @relation(fields: [betriebId], references: [id])
  name         String
  rolle        String  @default("MONTEUR") // MONTEUR | BUERO | CHEF
  email        String? @unique // e nevojshme vetëm për llogaritë me login
  passwortHash String  @default("")
  rapporte     Rapport[]
  sitzungen    Sitzung[]
}

// Sesionet e login-it (cookie httpOnly me token)
model Sitzung {
  id            String      @id @default(cuid())
  token         String      @unique
  mitarbeiterId String
  mitarbeiter   Mitarbeiter @relation(fields: [mitarbeiterId], references: [id], onDelete: Cascade)
  erstellt      DateTime    @default(now())
  gueltigBis    DateTime
}

model Kunde {
  id        String  @id @default(cuid())
  betriebId String
  betrieb   Betrieb @relation(fields: [betriebId], references: [id])
  name      String
  strasse   String  @default("")
  plz       String  @default("")
  ort       String  @default("")
  telefon   String  @default("")
  email     String  @default("")
  objekte   Objekt[]
  auftraege Auftrag[]
  offerten  Offerte[]
}

// Objekti/pajisja te klienti (kaldaja, bojleri, banjoja...) — njësia qendrore në SHK
model Objekt {
  id          String  @id @default(cuid())
  kundeId     String
  kunde       Kunde   @relation(fields: [kundeId], references: [id])
  bezeichnung String  // p.sh. "Heizung Keller — Viessmann Vitodens 200"
  strasse     String  @default("")
  plz         String  @default("")
  ort         String  @default("")
  bemerkung   String  @default("")
  auftraege   Auftrag[]
  offerten    Offerte[]
}

model Auftrag {
  id           String   @id @default(cuid())
  betriebId    String
  betrieb      Betrieb  @relation(fields: [betriebId], references: [id])
  kundeId      String
  kunde        Kunde    @relation(fields: [kundeId], references: [id])
  objektId     String?
  objekt       Objekt?  @relation(fields: [objektId], references: [id])
  nummer       Int
  titel        String
  beschreibung String   @default("")
  status       String   @default("OFFEN") // OFFEN | IN_ARBEIT | ERLEDIGT | VERRECHNET
  datum        DateTime @default(now())
  rapporte     Rapport[]
  rechnung     Rechnung?
  offerte      Offerte?
}

// Oferta (Angebot) me grupe pozicionesh hierarkike: 1 / 1.1 / 1.2 …
// (struktura e vërejtur te oferta reale e Wasserdichter me Bexio)
model Offerte {
  id         String   @id @default(cuid())
  betriebId  String
  betrieb    Betrieb  @relation(fields: [betriebId], references: [id])
  kundeId    String
  kunde      Kunde    @relation(fields: [kundeId], references: [id])
  objektId   String?
  objekt     Objekt?  @relation(fields: [objektId], references: [id])
  nummer     Int
  titel      String
  status     String   @default("ENTWURF") // ENTWURF | GESENDET | ANGENOMMEN | ABGELEHNT
  datum      DateTime @default(now())
  gueltigBis DateTime
  auftragId  String?  @unique // vendoset pas konvertimit Offerte → Auftrag
  auftrag    Auftrag? @relation(fields: [auftragId], references: [id])
  gruppen    OfferteGruppe[]
}

model OfferteGruppe {
  id          String  @id @default(cuid())
  offerteId   String
  offerte     Offerte @relation(fields: [offerteId], references: [id], onDelete: Cascade)
  reihenfolge Int     @default(0)
  titel       String
  positionen  OffertePosition[]
}

model OffertePosition {
  id          String        @id @default(cuid())
  gruppeId    String
  gruppe      OfferteGruppe @relation(fields: [gruppeId], references: [id], onDelete: Cascade)
  reihenfolge Int           @default(0)
  bezeichnung String // shumërreshtore: rreshtat shtesë bëhen bullets në PDF
  menge       Float         @default(1)
  einheit     String        @default("Stk.")
  ansatz      Float         @default(0)
}

// Regierapport / Serviceauftrag-dokumentimi nga tereni
model Rapport {
  id            String   @id @default(cuid())
  auftragId     String
  auftrag       Auftrag  @relation(fields: [auftragId], references: [id])
  mitarbeiterId String?
  mitarbeiter   Mitarbeiter? @relation(fields: [mitarbeiterId], references: [id])
  datum         DateTime @default(now())
  bemerkung     String   @default("")
  unterschrift  String   @default("") // nënshkrimi i klientit si data-URL (PNG)
  positionen    RapportPosition[]
}

model RapportPosition {
  id          String  @id @default(cuid())
  rapportId   String
  rapport     Rapport @relation(fields: [rapportId], references: [id], onDelete: Cascade)
  typ         String  // ARBEIT | MATERIAL
  bezeichnung String
  menge       Float   @default(1)
  einheit     String  @default("Std.") // Std. | Stk. | m | pauschal
  ansatz      Float   @default(0) // çmimi për njësi në CHF
}

// Furnitori (Debrunner Acifer, Meier Tobler, Sanitas Troesch…)
model Lieferant {
  id          String  @id @default(cuid())
  betriebId   String
  betrieb     Betrieb @relation(fields: [betriebId], references: [id])
  name        String
  artikel     Artikel[]
  konditionen Kondition[]
}

// Katalogu i artikujve (import CSV/Excel; më vonë IGH/DataExpert)
model Artikel {
  id           String     @id @default(cuid())
  betriebId    String
  betrieb      Betrieb    @relation(fields: [betriebId], references: [id])
  lieferantId  String?
  lieferant    Lieferant? @relation(fields: [lieferantId], references: [id])
  artikelNr    String     @default("")
  bezeichnung  String
  einheit      String     @default("Stk.")
  preis        Float      @default(0) // çmimi neto manual (për artikuj pa furnitor/zbritje)
  bruttoPreis  Float      @default(0) // çmimi bruto i katalogut
  rabattgruppe String     @default("") // grupi i zbritjes te furnitori
}

// Zbritja e firmës te një furnitor për një grup artikujsh:
// neto = bruttoPreis × (1 − rabattProzent/100)
model Kondition {
  id            String    @id @default(cuid())
  betriebId     String
  betrieb       Betrieb   @relation(fields: [betriebId], references: [id])
  lieferantId   String
  lieferant     Lieferant @relation(fields: [lieferantId], references: [id])
  rabattgruppe  String
  rabattProzent Float

  @@unique([betriebId, lieferantId, rabattgruppe])
}

model Rechnung {
  id         String   @id @default(cuid())
  betriebId  String
  betrieb    Betrieb  @relation(fields: [betriebId], references: [id])
  auftragId  String   @unique
  auftrag    Auftrag  @relation(fields: [auftragId], references: [id])
  nummer     Int
  datum      DateTime @default(now())
  status     String   @default("ENTWURF") // ENTWURF | VERSENDET | BEZAHLT
  totalNetto Float    @default(0)
  mwstSatz   Float    @default(8.1) // norma standarde CH 2026
  totalBrutto Float   @default(0)
}
